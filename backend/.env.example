# Copiar a .env y ajustar por entorno / proveedor.

PORT=8080

# Identifica el proveedor activo (solo para logs/health, no cambia la logica): aws | gcp | azure | oci | local
CLOUD_PROVIDER=local

# Driver de base de datos: memory | postgres | oracle
# - memory   -> sin base de datos externa (pruebas locales rapidas)
# - postgres -> AWS RDS / GCP Cloud SQL / Azure Database for PostgreSQL
# - oracle   -> OCI Autonomous Database
DB_DRIVER=memory

# --- Config Postgres (AWS RDS / GCP Cloud SQL / Azure DB for PostgreSQL) ---
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=unimarket
DB_SSL=true

# --- Config Oracle Autonomous DB (OCI) ---
# DB_CONNECT_STRING es el alias TNS del wallet (ej: unimarketdb_high)
# Requiere TNS_ADMIN apuntando a la carpeta del wallet descargado desde la consola de OCI.
DB_CONNECT_STRING=
TNS_ADMIN=/app/wallet
